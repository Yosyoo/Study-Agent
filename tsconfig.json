{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "skipLibCheck": true, "types": ["node", "vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "*.config.ts"]
}
